hat # Copy this file to .env and fill in what you have. Everything below has a
# safe local default or a mocked fallback — see README.md "Running without
# real API keys" for what happens when a value is left blank.

# --- Database -----------------------------------------------------------
# Local Postgres (docker compose up -d, see README) or any Postgres URL.
DATABASE_URL="postgresql://fixitnow:fixitnow@localhost:5432/fixitnow?schema=public"

# --- Auth (next-auth v5) --------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me"
AUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---------------------------------------------------
# Leave blank to run in mocked-payments mode (payments auto-"succeed" and
# skip the Stripe SDK entirely). Drop in real test keys to exercise the
# actual Stripe Elements + PaymentIntent flow.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Optional address geocoding -------------------------------------------
# Not needed for local login or booking. Leave blank for demo coordinates
# around Austin. These are not actual customer locations or live tracking.
# Setting a token enables address geocoding; it does not enable dispatch.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Realtime (self-hosted socket.io server, see server/) -----------------
WS_PORT="4001"
NEXT_PUBLIC_WS_URL="http://localhost:4001"
